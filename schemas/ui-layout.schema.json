{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spirit.game/schemas/ui-layout.schema.json",
  "title": "UI Layout",
  "description": "A declarative UI tree produced by the UI Generator agent. Only whitelisted components are allowed. Depth <= 6 and <= 60 nodes are enforced by the Validator.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "screen", "theme", "root"],
  "properties": {
    "schemaVersion": { "const": "1.1" },
    "id": { "type": "string", "pattern": "^ui-[a-z0-9-]+$" },
    "screen": { "type": "string", "enum": ["hud", "space-hud", "omen", "dialogue", "event", "inventory", "reflection", "menu"] },
    "theme": { "type": "string", "enum": ["spirit", "organic", "bone-and-ochre", "parchment", "ink-and-brass", "steam-and-iron", "flat-digital", "neon-holo", "luminous-minimal"] },
    "accentOverride": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "root": { "$ref": "#/$defs/node" }
  },
  "$defs": {
    "text": { "type": "string", "maxLength": 600 },
    "bind": { "type": "string", "pattern": "^/(player|world|scene)(/[A-Za-z0-9_-]+)+$" },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verb"],
      "properties": {
        "verb": {
          "type": "string",
          "enum": ["move", "look", "talk", "give", "take", "use", "buy", "sell", "work", "rest", "eat", "attack", "flee", "hide", "craft", "learn", "travel", "incarnate.request", "reflect.continue", "travel.request", "dialogue.say", "ui.close", "ui.open", "ui.tab"]
        },
        "params": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["Panel", "Stack", "Text", "Stat", "Bar", "Button", "Choice", "Dialog", "TextInput", "Inventory", "Map", "Image", "Toast", "Divider"]
        },
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "props": { "$ref": "#/$defs/props" },
        "children": { "type": "array", "items": { "$ref": "#/$defs/node" }, "maxItems": 20 }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "enum": ["Text", "Stat", "Bar", "Button", "Choice", "TextInput", "Inventory", "Map", "Image", "Toast", "Divider"] } } },
          "then": { "not": { "required": ["children"] } }
        },
        {
          "if": { "properties": { "type": { "const": "Button" } } },
          "then": { "required": ["props"], "properties": { "props": { "type": "object", "required": ["label", "action"] } } }
        },
        {
          "if": { "properties": { "type": { "const": "Choice" } } },
          "then": { "required": ["props"], "properties": { "props": { "type": "object", "required": ["options"] } } }
        },
        {
          "if": { "properties": { "type": { "enum": ["Stat", "Bar", "Inventory"] } } },
          "then": { "required": ["props"], "properties": { "props": { "type": "object", "required": ["bind"] } } }
        }
      ]
    },
    "props": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "$ref": "#/$defs/text" },
        "text": { "$ref": "#/$defs/text" },
        "label": { "type": "string", "maxLength": 60 },
        "placeholder": { "type": "string", "maxLength": 80 },
        "bind": { "$ref": "#/$defs/bind" },
        "format": { "type": "string", "enum": ["int", "percent", "currency", "clock", "date"] },
        "icon": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "max": { "type": "number" },
        "warnBelow": { "type": "number" },
        "color": { "type": "string", "enum": ["accent", "danger", "warning", "success", "muted", "health", "hunger", "energy", "spirit"] },
        "anchor": { "type": "string", "enum": ["top-left", "top", "top-right", "left", "center", "right", "bottom-left", "bottom", "bottom-right"] },
        "width": { "type": "string", "enum": ["xs", "sm", "md", "lg", "full"] },
        "variant": { "type": "string", "enum": ["default", "subtle", "ornate", "alert"] },
        "direction": { "type": "string", "enum": ["row", "column"] },
        "gap": { "type": "integer", "minimum": 0, "maximum": 32 },
        "align": { "type": "string", "enum": ["start", "center", "end", "stretch"] },
        "size": { "type": "string", "enum": ["sm", "md", "lg", "xl"] },
        "style": { "type": "string", "enum": ["body", "title", "whisper", "mono"] },
        "action": { "$ref": "#/$defs/action" },
        "hotkey": { "type": "string", "pattern": "^[A-Z0-9]$" },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "action"],
            "properties": {
              "label": { "type": "string", "maxLength": 80 },
              "hint": { "type": "string", "maxLength": 120 },
              "action": { "$ref": "#/$defs/action" },
              "disabled": { "type": "boolean" }
            }
          }
        },
        "speakerId": { "type": "string", "pattern": "^npc-[a-z0-9-]+$" },
        "portraitAssetId": { "type": "string", "pattern": "^asset-[a-z0-9-]+$" },
        "assetId": { "type": "string", "pattern": "^asset-[a-z0-9-]+$" },
        "columns": { "type": "integer", "minimum": 1, "maximum": 10 },
        "kind": { "type": "string", "enum": ["minimap", "region", "system"] },
        "durationMs": { "type": "integer", "minimum": 500, "maximum": 15000 },
        "tone": { "type": "string", "enum": ["info", "good", "bad", "mystic"] }
      }
    }
  }
}
