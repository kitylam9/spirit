# Copy to .env and edit. The server reads it from the repo root. Empty values use defaults.

# ---- LLM provider -----------------------------------------------------------
# ollama     : Ollama native API (http://localhost:11434), structured output via `format`
# llamacpp   : llama.cpp `llama-server` OpenAI-compatible API (http://localhost:8080)
#              Also works for LM Studio (LLM_BASE_URL=http://localhost:1234), vLLM, KoboldCpp...
# openrouter : OpenRouter (https://openrouter.ai), including free models; needs OPENROUTER_API_KEY
# openai     : any hosted OpenAI-compatible API (needs LLM_API_KEY)
# none       : no LLM; everything is generated procedurally (fast, good for testing)
LLM_PROVIDER=ollama

# ---- OpenRouter ---------------------------------------------------------------
# Create a key at https://openrouter.ai/keys and paste it here.
OPENROUTER_API_KEY=
# With LLM_PROVIDER=openrouter, LLM_MODEL defaults to google/gemma-4-31b-it:free.
# Free model ids end in ":free" and change over time; the server lists the current ones
# at startup if the configured model is gone. Free models are rate limited (~20 requests/min,
# small daily quota), so keep LLM_MAX_CONCURRENCY at 1-2.

# Leave empty to use the provider default.
LLM_BASE_URL=
# Ollama: a pulled model tag, e.g. llama3.1:8b, qwen2.5:7b-instruct, qwen3-coder
# llama.cpp: any string (llama-server serves the model it was started with)
# OpenRouter: a model id, e.g. google/gemma-4-31b-it:free
LLM_MODEL=
# API key for LLM_PROVIDER=openai (or any OpenAI-compatible server that needs one).
LLM_API_KEY=

# schema : constrained decoding with the agent's draft JSON Schema (most reliable locally)
# object : plain JSON mode; the schema is put in the prompt instead (default for openrouter/openai)
# off    : no JSON mode; the schema is put in the prompt and output is parsed leniently
LLM_JSON_MODE=

# Generation calls give up after this and use procedural fallbacks.
LLM_TIMEOUT_MS=120000
# Parallel requests to the LLM. Keep 1-2 for a single local GPU or a free OpenRouter model.
LLM_MAX_CONCURRENCY=2
# Ollama only: context window. Large values can spill the model onto the CPU.
LLM_NUM_CTX=8192

# ---- Server -----------------------------------------------------------------
PORT=8787
# Save files (one JSON per player). Relative to the server working directory.
# DATA_DIR=./data
