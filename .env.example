# Copy to .env and edit. The server reads it from the repo root.

# ---- LLM provider -----------------------------------------------------------
# ollama   : Ollama native API (http://localhost:11434), structured output via `format`
# llamacpp : llama.cpp `llama-server` OpenAI-compatible API (http://localhost:8080)
#            Also works for LM Studio (LLM_BASE_URL=http://localhost:1234), vLLM, KoboldCpp...
# openai   : any hosted OpenAI-compatible API (needs LLM_API_KEY)
# none     : no LLM; everything is generated procedurally (fast, good for testing)
LLM_PROVIDER=ollama

# Leave empty to use the provider default.
LLM_BASE_URL=
# Ollama: a pulled model tag, e.g. llama3.1:8b, qwen2.5:7b-instruct, qwen3-coder
# llama.cpp: any string (llama-server serves the model it was started with)
LLM_MODEL=llama3.1:8b
LLM_API_KEY=

# schema : constrained decoding with the agent's draft JSON Schema (most reliable)
# object : plain JSON mode; the schema is put in the prompt instead
# off    : no JSON mode; the schema is put in the prompt and output is parsed leniently
LLM_JSON_MODE=schema

# Local models can be slow; generation calls give up after this and use procedural fallbacks.
LLM_TIMEOUT_MS=120000
# Parallel requests to the LLM. Keep 1-2 for a single local GPU.
LLM_MAX_CONCURRENCY=2
# Ollama only: context window. Large values can spill the model onto the CPU.
LLM_NUM_CTX=8192

# ---- Server -----------------------------------------------------------------
PORT=8787
# Save files (one JSON per player). Relative to the server working directory.
# DATA_DIR=./data
